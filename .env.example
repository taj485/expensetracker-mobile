# Copy to .env.local and fill in. EXPO_PUBLIC_* values are bundled into the app,
# so never put secrets here — Auth0 domain / client ID / audience are public identifiers.

# Local API: a phone can't reach "localhost". Use your PC's LAN IP (e.g. http://192.168.1.20:5000/api),
# or http://10.0.2.2:<port>/api from the Android emulator.
# Production: https://app-expensetracker-prod.azurewebsites.net/api
EXPO_PUBLIC_API_URL=https://app-expensetracker-prod.azurewebsites.net/api

EXPO_PUBLIC_AUTH0_DOMAIN=dev-sizppb5m3zuup43h.us.auth0.com
# Client ID of the Auth0 *Native* application (not the web SPA's client ID)
EXPO_PUBLIC_AUTH0_CLIENT_ID=
EXPO_PUBLIC_AUTH0_AUDIENCE=https://api.expensetracker

# Dev-only: set to true to skip login and use built-in fake spaces/expenses (src/core/sample).
# Ignored in release builds. Leave unset for real Auth0 login and API data.
# EXPO_PUBLIC_USE_SAMPLE_DATA=true

# logo.dev publishable key (pk_...) for merchant logos — same one the web client uses.
# Never put an sk_ secret key here. Leave empty to show merchant initials instead.
EXPO_PUBLIC_LOGO_DEV_TOKEN=
