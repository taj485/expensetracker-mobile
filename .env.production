# Production API, used by production builds (NODE_ENV=production). Expo bundles these values into the app, so nothing here is secret.
EXPO_PUBLIC_API_URL=https://www.recave.co.uk/api

EXPO_PUBLIC_AUTH0_DOMAIN=dev-sizppb5m3zuup43h.us.auth0.com
# Client ID of the Auth0 *Native* application (not the web SPA's client ID)
EXPO_PUBLIC_AUTH0_CLIENT_ID=cAEBfhaGLNpsNUtm1RXOVfprt8NeqkLL
EXPO_PUBLIC_AUTH0_AUDIENCE=https://api.expensetracker

# logo.dev publishable key (pk_...) for merchant logos. Never put an sk_ secret key here.
EXPO_PUBLIC_LOGO_DEV_TOKEN=pk_XwdHh7UrRWaC9z3If7rFpg

# Real login and data from the API.
EXPO_PUBLIC_USE_SAMPLE_DATA=false
